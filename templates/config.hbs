<form class="jenne-auto-color-form" autocomplete="off">
  <div class="jenne-settings-container jenne-auto-color-container">
    <header class="settings-header">
      <h2><i class="fas fa-palette"></i> Jenne Auto Color Folder</h2>
      <p class="settings-subtext">Configure fantasy themes, races & classes, folder nesting depth, and indentation.</p>
    </header>

    <div class="settings-body">
      <!-- Section 1: General & Color Palette Theme -->
      <div class="jenne-section-card">
        <h3 class="jenne-section-title"><i class="fas fa-swatchbook"></i> Color Theme & Mode</h3>
        
        <!-- Master Enable Toggle -->
        <div class="jenne-form-row">
          <div class="jenne-label-block">
            <label>{{localize "JENNEAUTOCOLOR.autocolorfolder"}}</label>
            <span class="jenne-hint">{{localize "JENNEAUTOCOLOR.autocolorfolderHint"}}</span>
          </div>
          <div class="jenne-input-block">
            <input type="checkbox" name="autoColorFolder" {{checked autoColorFolder}} class="jenne-checkbox" />
          </div>
        </div>

        <!-- Color Mode Selection -->
        <div class="jenne-form-row">
          <div class="jenne-label-block">
            <label>{{localize "JENNEAUTOCOLOR.selectColorMode"}}</label>
            <span class="jenne-hint">{{localize "JENNEAUTOCOLOR.selectColorModeHint"}}</span>
          </div>
          <div class="jenne-input-block">
            <select name="selectColorMode" class="jenne-select">
              <option value="0" {{#if (eq selectColorMode 0)}}selected{{/if}}>{{localize "JENNEAUTOCOLOR.options.colormode.choices.0"}}</option>
              <option value="1" {{#if (eq selectColorMode 1)}}selected{{/if}}>{{localize "JENNEAUTOCOLOR.options.colormode.choices.1"}}</option>
              <option value="3" {{#if (eq selectColorMode 3)}}selected{{/if}}>{{localize "JENNEAUTOCOLOR.options.colormode.choices.3"}}</option>
              <option value="2" {{#if (eq selectColorMode 2)}}selected{{/if}}>{{localize "JENNEAUTOCOLOR.options.colormode.choices.2"}}</option>
            </select>
          </div>
        </div>

        <!-- Palette Theme -->
        <div class="jenne-form-row">
          <div class="jenne-label-block">
            <label>{{localize "JENNEAUTOCOLOR.colorPalette"}}</label>
            <span class="jenne-hint">{{localize "JENNEAUTOCOLOR.colorPaletteHint"}}</span>
          </div>
          <div class="jenne-input-block">
            <select name="colorPalette" class="jenne-select">
              <optgroup label="Fantasy Races & Realms (LoTR & D&D)">
                <option value="elven" {{#if (eq colorPalette "elven")}}selected{{/if}}>{{localize "JENNEAUTOCOLOR.options.palette.elven"}}</option>
                <option value="dwarven" {{#if (eq colorPalette "dwarven")}}selected{{/if}}>{{localize "JENNEAUTOCOLOR.options.palette.dwarven"}}</option>
                <option value="mordor" {{#if (eq colorPalette "mordor")}}selected{{/if}}>{{localize "JENNEAUTOCOLOR.options.palette.mordor"}}</option>
                <option value="underdark" {{#if (eq colorPalette "underdark")}}selected{{/if}}>{{localize "JENNEAUTOCOLOR.options.palette.underdark"}}</option>
                <option value="dragon" {{#if (eq colorPalette "dragon")}}selected{{/if}}>{{localize "JENNEAUTOCOLOR.options.palette.dragon"}}</option>
              </optgroup>
              <optgroup label="D&D Classes & Archetypes">
                <option value="wizard" {{#if (eq colorPalette "wizard")}}selected{{/if}}>{{localize "JENNEAUTOCOLOR.options.palette.wizard"}}</option>
                <option value="bard" {{#if (eq colorPalette "bard")}}selected{{/if}}>{{localize "JENNEAUTOCOLOR.options.palette.bard"}}</option>
                <option value="paladin" {{#if (eq colorPalette "paladin")}}selected{{/if}}>{{localize "JENNEAUTOCOLOR.options.palette.paladin"}}</option>
                <option value="druid" {{#if (eq colorPalette "druid")}}selected{{/if}}>{{localize "JENNEAUTOCOLOR.options.palette.druid"}}</option>
                <option value="rogue" {{#if (eq colorPalette "rogue")}}selected{{/if}}>{{localize "JENNEAUTOCOLOR.options.palette.rogue"}}</option>
                <option value="warlock" {{#if (eq colorPalette "warlock")}}selected{{/if}}>{{localize "JENNEAUTOCOLOR.options.palette.warlock"}}</option>
              </optgroup>
              <optgroup label="Atmospheric & Aesthetic Palettes">
                <option value="beneos" {{#if (eq colorPalette "beneos")}}selected{{/if}}>{{localize "JENNEAUTOCOLOR.options.palette.beneos"}}</option>
                <option value="darkFantasy" {{#if (eq colorPalette "darkFantasy")}}selected{{/if}}>{{localize "JENNEAUTOCOLOR.options.palette.darkFantasy"}}</option>
                <option value="earth" {{#if (eq colorPalette "earth")}}selected{{/if}}>{{localize "JENNEAUTOCOLOR.options.palette.earth"}}</option>
                <option value="nordic" {{#if (eq colorPalette "nordic")}}selected{{/if}}>{{localize "JENNEAUTOCOLOR.options.palette.nordic"}}</option>
                <option value="pastel" {{#if (eq colorPalette "pastel")}}selected{{/if}}>{{localize "JENNEAUTOCOLOR.options.palette.pastel"}}</option>
                <option value="monochrome" {{#if (eq colorPalette "monochrome")}}selected{{/if}}>{{localize "JENNEAUTOCOLOR.options.palette.monochrome"}}</option>
                <option value="cyberpunk" {{#if (eq colorPalette "cyberpunk")}}selected{{/if}}>{{localize "JENNEAUTOCOLOR.options.palette.cyberpunk"}}</option>
                <option value="rainbow" {{#if (eq colorPalette "rainbow")}}selected{{/if}}>{{localize "JENNEAUTOCOLOR.options.palette.rainbow"}}</option>
              </optgroup>
            </select>
          </div>
        </div>

        <!-- Opacity Slider -->
        <div class="jenne-form-row">
          <div class="jenne-label-block">
            <label>{{localize "JENNEAUTOCOLOR.folderOpacity"}}</label>
            <span class="jenne-hint">{{localize "JENNEAUTOCOLOR.folderOpacityHint"}}</span>
          </div>
          <div class="jenne-input-block slider-block">
            <input type="range" name="folderOpacity" value="{{folderOpacity}}" min="0.1" max="0.9" step="0.05" class="jenne-slider" oninput="this.nextElementSibling.innerText = Math.round(this.value * 100) + '%'" />
            <span class="jenne-badge">{{percentOpacity}}</span>
          </div>
        </div>
      </div>

      <!-- Section 2: Hierarchy & Depth Settings -->
      <div class="jenne-section-card">
        <h3 class="jenne-section-title"><i class="fas fa-folder-tree"></i> Depth & Hierarchy</h3>

        <!-- Subfolder Indentation -->
        <div class="jenne-form-row">
          <div class="jenne-label-block">
            <label>{{localize "JENNEAUTOCOLOR.subfolderIndent"}}</label>
            <span class="jenne-hint">{{localize "JENNEAUTOCOLOR.subfolderIndentHint"}}</span>
          </div>
          <div class="jenne-input-block slider-block">
            <input type="range" name="subfolderIndent" value="{{subfolderIndent}}" min="0" max="30" step="2" class="jenne-slider" oninput="this.nextElementSibling.innerText = this.value + 'px'" />
            <span class="jenne-badge">{{subfolderIndent}}px</span>
          </div>
        </div>

        <!-- Depth Luminance Shading -->
        <div class="jenne-form-row">
          <div class="jenne-label-block">
            <label>{{localize "JENNEAUTOCOLOR.depthLuminance"}}</label>
            <span class="jenne-hint">{{localize "JENNEAUTOCOLOR.depthLuminanceHint"}}</span>
          </div>
          <div class="jenne-input-block">
            <select name="depthLuminance" class="jenne-select">
              <option value="lighter" {{#if (eq depthLuminance "lighter")}}selected{{/if}}>{{localize "JENNEAUTOCOLOR.options.depthLuminance.lighter"}}</option>
              <option value="darker" {{#if (eq depthLuminance "darker")}}selected{{/if}}>{{localize "JENNEAUTOCOLOR.options.depthLuminance.darker"}}</option>
              <option value="subtleFade" {{#if (eq depthLuminance "subtleFade")}}selected{{/if}}>{{localize "JENNEAUTOCOLOR.options.depthLuminance.subtleFade"}}</option>
              <option value="none" {{#if (eq depthLuminance "none")}}selected{{/if}}>{{localize "JENNEAUTOCOLOR.options.depthLuminance.none"}}</option>
            </select>
          </div>
        </div>

        <!-- Tree Guide Lines -->
        <div class="jenne-form-row">
          <div class="jenne-label-block">
            <label>{{localize "JENNEAUTOCOLOR.depthTreeLines"}}</label>
            <span class="jenne-hint">{{localize "JENNEAUTOCOLOR.depthTreeLinesHint"}}</span>
          </div>
          <div class="jenne-input-block">
            <input type="checkbox" name="depthTreeLines" {{checked depthTreeLines}} class="jenne-checkbox" />
          </div>
        </div>
      </div>
    </div>

    <!-- Jenne Suite Footer with Apply and Close buttons -->
    <footer class="settings-footer">
      <button type="button" class="jenne-btn btn-secondary close-btn" data-action="close">
        <i class="fas fa-times"></i> Close
      </button>
      <button type="button" class="jenne-btn btn-primary apply-btn" data-action="apply">
        <i class="fas fa-check"></i> Apply Settings
      </button>
    </footer>
  </div>
</form>
