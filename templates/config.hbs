<form class="jenne-auto-color-config-form" autocomplete="off">
    <div class="form-content">
        <!-- Master Enable Toggle -->
        <div class="form-group">
            <label>{{localize "JENNEAUTOCOLOR.autocolorfolder"}}</label>
            <div class="form-fields">
                <input type="checkbox" name="autoColorFolder" {{checked autoColorFolder}} />
            </div>
            <p class="notes">{{localize "JENNEAUTOCOLOR.autocolorfolderHint"}}</p>
        </div>

        <!-- Color Mode Selection -->
        <div class="form-group">
            <label>{{localize "JENNEAUTOCOLOR.selectColorMode"}}</label>
            <div class="form-fields">
                <select name="selectColorMode">
                    <option value="3" {{#if (eq selectColorMode 3)}}selected{{/if}}>{{localize "JENNEAUTOCOLOR.options.colormode.choices.3"}}</option>
                    <option value="1" {{#if (eq selectColorMode 1)}}selected{{/if}}>{{localize "JENNEAUTOCOLOR.options.colormode.choices.1"}}</option>
                    <option value="4" {{#if (eq selectColorMode 4)}}selected{{/if}}>{{localize "JENNEAUTOCOLOR.options.colormode.choices.4"}}</option>
                    <option value="0" {{#if (eq selectColorMode 0)}}selected{{/if}}>{{localize "JENNEAUTOCOLOR.options.colormode.choices.0"}}</option>
                    <option value="2" {{#if (eq selectColorMode 2)}}selected{{/if}}>{{localize "JENNEAUTOCOLOR.options.colormode.choices.2"}}</option>
                </select>
            </div>
            <p class="notes">{{localize "JENNEAUTOCOLOR.selectColorModeHint"}}</p>
        </div>

        <!-- Palette Theme -->
        <div class="form-group">
            <label>{{localize "JENNEAUTOCOLOR.colorPalette"}}</label>
            <div class="form-fields">
                <select name="colorPalette">
                    <option value="darkFantasy" {{#if (eq colorPalette "darkFantasy")}}selected{{/if}}>{{localize "JENNEAUTOCOLOR.options.palette.darkFantasy"}}</option>
                    <option value="earth" {{#if (eq colorPalette "earth")}}selected{{/if}}>{{localize "JENNEAUTOCOLOR.options.palette.earth"}}</option>
                    <option value="beneos" {{#if (eq colorPalette "beneos")}}selected{{/if}}>{{localize "JENNEAUTOCOLOR.options.palette.beneos"}}</option>
                    <option value="nordic" {{#if (eq colorPalette "nordic")}}selected{{/if}}>{{localize "JENNEAUTOCOLOR.options.palette.nordic"}}</option>
                    <option value="pastel" {{#if (eq colorPalette "pastel")}}selected{{/if}}>{{localize "JENNEAUTOCOLOR.options.palette.pastel"}}</option>
                    <option value="monochrome" {{#if (eq colorPalette "monochrome")}}selected{{/if}}>{{localize "JENNEAUTOCOLOR.options.palette.monochrome"}}</option>
                    <option value="cyberpunk" {{#if (eq colorPalette "cyberpunk")}}selected{{/if}}>{{localize "JENNEAUTOCOLOR.options.palette.cyberpunk"}}</option>
                    <option value="rainbow" {{#if (eq colorPalette "rainbow")}}selected{{/if}}>{{localize "JENNEAUTOCOLOR.options.palette.rainbow"}}</option>
                </select>
            </div>
            <p class="notes">{{localize "JENNEAUTOCOLOR.colorPaletteHint"}}</p>
        </div>

        <!-- Hierarchy & Depth Section -->
        <fieldset class="jenne-fieldset">
            <legend><i class="fas fa-folder-tree"></i> Depth & Hierarchy</legend>

            <!-- Subfolder Indentation -->
            <div class="form-group">
                <label>{{localize "JENNEAUTOCOLOR.subfolderIndent"}}</label>
                <div class="form-fields">
                    <input type="range" name="subfolderIndent" value="{{subfolderIndent}}" min="0" max="30" step="2" oninput="this.nextElementSibling.value = this.value + 'px'" />
                    <span class="range-value">{{subfolderIndent}}px</span>
                </div>
                <p class="notes">{{localize "JENNEAUTOCOLOR.subfolderIndentHint"}}</p>
            </div>

            <!-- Depth Luminance Shading -->
            <div class="form-group">
                <label>{{localize "JENNEAUTOCOLOR.depthLuminance"}}</label>
                <div class="form-fields">
                    <select name="depthLuminance">
                        <option value="lighter" {{#if (eq depthLuminance "lighter")}}selected{{/if}}>{{localize "JENNEAUTOCOLOR.options.depthLuminance.lighter"}}</option>
                        <option value="darker" {{#if (eq depthLuminance "darker")}}selected{{/if}}>{{localize "JENNEAUTOCOLOR.options.depthLuminance.darker"}}</option>
                        <option value="subtleFade" {{#if (eq depthLuminance "subtleFade")}}selected{{/if}}>{{localize "JENNEAUTOCOLOR.options.depthLuminance.subtleFade"}}</option>
                        <option value="none" {{#if (eq depthLuminance "none")}}selected{{/if}}>{{localize "JENNEAUTOCOLOR.options.depthLuminance.none"}}</option>
                    </select>
                </div>
                <p class="notes">{{localize "JENNEAUTOCOLOR.depthLuminanceHint"}}</p>
            </div>

            <!-- Tree Lines -->
            <div class="form-group">
                <label>{{localize "JENNEAUTOCOLOR.depthTreeLines"}}</label>
                <div class="form-fields">
                    <input type="checkbox" name="depthTreeLines" {{checked depthTreeLines}} />
                </div>
                <p class="notes">{{localize "JENNEAUTOCOLOR.depthTreeLinesHint"}}</p>
            </div>

            <!-- Opacity -->
            <div class="form-group">
                <label>{{localize "JENNEAUTOCOLOR.folderOpacity"}}</label>
                <div class="form-fields">
                    <input type="range" name="folderOpacity" value="{{folderOpacity}}" min="0.1" max="0.9" step="0.05" oninput="this.nextElementSibling.value = Math.round(this.value * 100) + '%'" />
                    <span class="range-value">{{percentOpacity}}</span>
                </div>
                <p class="notes">{{localize "JENNEAUTOCOLOR.folderOpacityHint"}}</p>
            </div>
        </fieldset>

        <!-- Category Gradient Start Colors -->
        <fieldset class="jenne-fieldset">
            <legend><i class="fas fa-palette"></i> Category Colors (for Gradient Mode)</legend>

            <div class="form-group">
                <label>{{localize "JENNEAUTOCOLOR.options.colorselector.actorTitle"}}</label>
                <div class="form-fields">
                    <color-picker name="colorSettings.actor" value="{{colorSettings.actor}}"></color-picker>
                </div>
            </div>

            <div class="form-group">
                <label>{{localize "JENNEAUTOCOLOR.options.colorselector.sceneTitle"}}</label>
                <div class="form-fields">
                    <color-picker name="colorSettings.scene" value="{{colorSettings.scene}}"></color-picker>
                </div>
            </div>

            <div class="form-group">
                <label>{{localize "JENNEAUTOCOLOR.options.colorselector.itemTitle"}}</label>
                <div class="form-fields">
                    <color-picker name="colorSettings.item" value="{{colorSettings.item}}"></color-picker>
                </div>
            </div>

            <div class="form-group">
                <label>{{localize "JENNEAUTOCOLOR.options.colorselector.journalTitle"}}</label>
                <div class="form-fields">
                    <color-picker name="colorSettings.journal" value="{{colorSettings.journal}}"></color-picker>
                </div>
            </div>

            <div class="form-group">
                <label>{{localize "JENNEAUTOCOLOR.options.colorselector.compendiumTitle"}}</label>
                <div class="form-fields">
                    <color-picker name="colorSettings.compendium" value="{{colorSettings.compendium}}"></color-picker>
                </div>
            </div>

            <div class="form-group">
                <label>{{localize "JENNEAUTOCOLOR.options.colorselector.rollTableTitle"}}</label>
                <div class="form-fields">
                    <color-picker name="colorSettings.rollTable" value="{{colorSettings.rollTable}}"></color-picker>
                </div>
            </div>

            <div class="form-group">
                <label>{{localize "JENNEAUTOCOLOR.options.colorselector.playlistTitle"}}</label>
                <div class="form-fields">
                    <color-picker name="colorSettings.playlist" value="{{colorSettings.playlist}}"></color-picker>
                </div>
            </div>

            <div class="form-group">
                <label>{{localize "JENNEAUTOCOLOR.options.colorselector.cardsTitle"}}</label>
                <div class="form-fields">
                    <color-picker name="colorSettings.cards" value="{{colorSettings.cards}}"></color-picker>
                </div>
            </div>
        </fieldset>
    </div>

    <footer class="sheet-footer flexrow">
        <button type="submit" name="submit">
            <i class="fas fa-save"></i> Save Settings
        </button>
    </footer>
</form>
